CXX = g++
CXXFLAGS_BASE = -Wall -Wextra -std=c++20 -I. $(shell pkg-config --cflags gtk+-3.0)
CXXFLAGS = $(CXXFLAGS_BASE) -O2
CXXFLAGS_DEBUG = $(CXXFLAGS_BASE) -g -O0 -DDEBUG
CXXFLAGS_TEST = -Wall -Wextra -std=c++20 -O2 -I. -DRALLY_NO_GTK -pthread
LDFLAGS = $(shell pkg-config --libs gtk+-3.0) -lasound -lpthread -ldl
TARGET = HistoricRallyMeter
TARGET_DEBUG = HistoricRallyMeter_debug
TEST_TARGET = run_tests

# Main application sources
SOURCES = main.cpp i2c_counter.cpp sim_counter.cpp rally_state.cpp config_file.cpp counter_poller.cpp \
          calculations.cpp ui_driver.cpp ui_copilot.cpp ui_control.cpp callbacks.cpp tone_generator.cpp \
          simple_tone.cpp arrow_tone.cpp tone_cadence.cpp debug_log.cpp stage_log.cpp nero_frame.cpp ui_home.cpp ui_home_italian.cpp stage_rows.cpp stage_store.cpp home_calc.cpp freeze.cpp sector.cpp surrey.cpp reaction_offset.cpp driver_trial.cpp sector_edit.cpp stage_edit.cpp ui_segments.cpp ui_datetime.cpp ui_calibration.cpp ui_settings.cpp ui_setup.cpp pi_setup.cpp \
          webserver/rally_web_server.cpp webserver/web_telemetry.cpp webserver/web_commands.cpp \
          webserver/qr_display.cpp stage_file.cpp stage_phase.cpp rally_tick.cpp config_saver.cpp
OBJECTS = $(SOURCES:.cpp=.o)
OBJECTS_DEBUG = $(SOURCES:.cpp=_debug.o)

# Header dependencies are generated by the compiler (-MMD -MP) into a .d file
# beside each object, so every header an object really includes -- including
# webserver/*.h and tests/*.h -- triggers its rebuild. A stale object linked
# against a changed struct layout shows up as heap corruption, not a build error.
DEPFLAGS = -MMD -MP
DEPS = $(OBJECTS:.o=.d) $(OBJECTS_DEBUG:.o=.d) $(TEST_OBJECTS:.o=.d)

# Test objects: each library source recompiled with -DRALLY_NO_GTK as <name>_test.o,
# plus tests/test_main.o (which includes every tests/*.h).
TEST_LIB_SOURCES = calculations.cpp rally_state.cpp config_file.cpp sim_counter.cpp counter_poller.cpp \
               simple_tone.cpp arrow_tone.cpp tone_cadence.cpp stage_rows.cpp stage_store.cpp home_calc.cpp \
               freeze.cpp sector.cpp surrey.cpp reaction_offset.cpp driver_trial.cpp debug_log.cpp \
               stage_log.cpp stage_file.cpp stage_phase.cpp rally_tick.cpp config_saver.cpp
TEST_LIB_OBJECTS = $(TEST_LIB_SOURCES:.cpp=_test.o)
TEST_OBJECTS = tests/test_main.o $(TEST_LIB_OBJECTS)

# Default target
all: $(TARGET)

# Debug target
debug: $(TARGET_DEBUG)

$(TARGET): $(OBJECTS)
	$(CXX) $(CXXFLAGS) -o $(TARGET) $(OBJECTS) $(LDFLAGS)

$(TARGET_DEBUG): $(OBJECTS_DEBUG)
	$(CXX) $(CXXFLAGS_DEBUG) -o $(TARGET_DEBUG) $(OBJECTS_DEBUG) $(LDFLAGS)

%.o: %.cpp
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -c $< -o $@

%_debug.o: %.cpp
	$(CXX) $(CXXFLAGS_DEBUG) $(DEPFLAGS) -c $< -o $@

# Test targets
test: $(TEST_TARGET)
	./$(TEST_TARGET)

$(TEST_TARGET): $(TEST_OBJECTS)
	$(CXX) $(CXXFLAGS_TEST) -o $(TEST_TARGET) $(TEST_OBJECTS)

tests/test_main.o: tests/test_main.cpp
	$(CXX) $(CXXFLAGS_TEST) $(DEPFLAGS) -c $< -o $@

$(TEST_LIB_OBJECTS): %_test.o: %.cpp
	$(CXX) $(CXXFLAGS_TEST) $(DEPFLAGS) -c $< -o $@

-include $(DEPS)

clean:
	rm -f $(TARGET) $(TARGET_DEBUG) $(OBJECTS) $(OBJECTS_DEBUG) $(TEST_TARGET) $(TEST_OBJECTS) $(DEPS)

.PHONY: all clean test debug
